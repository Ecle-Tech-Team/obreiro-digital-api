# Obreiro Digital em produção (deploy/compose.yaml). Copie para deploy/.env e preencha.
# Segredos: gere cada um com   openssl rand -hex 32   (não reaproveite os de desenvolvimento).

# Endereço público pelo túnel (sem barra no fim). Vazio = só rede local.
APP_URL=https://obreiro.seudominio.com.br

# Porta na rede local: http://<servidor>:8080
LAN_PORT=8080

# "public" liga o Cloudflare Tunnel. Vazio = só rede local.
COMPOSE_PROFILES=public
# Token do túnel (Cloudflare Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# Banco (criado no primeiro start; trocar depois exige recriar o usuário no MySQL).
DB_NAME=obreiro_digital
DB_USER=obreiro
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Assina as sessões. Trocar desconecta todo mundo e invalida códigos de recuperação.
JWT_SECRET=

# Email (recuperação de senha e relatos de bug).
# Gmail: EMAIL_CONTATO e uma senha de app de 16 letras em SENHA_CONTATO
# (Conta Google > Segurança > Verificação em duas etapas > Senhas de app).
EMAIL_CONTATO=
SENHA_CONTATO=
# Outro provedor SMTP (substitui o Gmail quando SMTP_HOST está preenchido).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Backup diário em deploy/backups.
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14

# Memória (o TrueNAS precisa da maior parte da RAM para o ZFS).
DB_MEM_LIMIT=768m
DB_BUFFER_POOL=256M
API_MEM_LIMIT=256m
FRONTEND_MEM_LIMIT=384m
